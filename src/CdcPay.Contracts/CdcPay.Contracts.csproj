<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(AppTargetFramework)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Avro" />
  </ItemGroup>

  <!-- Every contract version ships with the assembly: tests check the generated classes
       against the latest one and resolution between all of them. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\contracts\avro\v1\PayEvent.avsc" LogicalName="contracts.avro.v1.PayEvent.avsc" />
    <EmbeddedResource Include="..\..\contracts\avro\v2\PayEvent.avsc" LogicalName="contracts.avro.v2.PayEvent.avsc" />
  </ItemGroup>

</Project>

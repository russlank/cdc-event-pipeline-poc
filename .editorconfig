root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,avsc,xml,props,targets,csproj,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_new_line_before_open_brace = all
csharp_style_var_for_built_in_types = false:suggestion
dotnet_sort_system_directives_first = true
dotnet_analyzer_diagnostic.severity = warning

# Style preferences, enforced by build and dotnet format.
csharp_style_namespace_declarations = file_scoped
csharp_style_var_for_built_in_types = false
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = false
csharp_style_prefer_primary_constructors = true
# Expression or block bodies for methods are the author's choice.
dotnet_diagnostic.IDE0022.severity = none
# Fluent builder calls return values that are deliberately ignored.
dotnet_diagnostic.IDE0058.severity = none
# Readability calls left to the author: listing every case beside a default or discard arm
# (IDE0010, IDE0072), and turning if/return blocks into conditional expressions (IDE0045, IDE0046).
dotnet_diagnostic.IDE0010.severity = none
dotnet_diagnostic.IDE0072.severity = none
dotnet_diagnostic.IDE0045.severity = none
dotnet_diagnostic.IDE0046.severity = none

# Test names follow Method_State_ExpectedBehavior, which needs underscores.
[src/CdcPay.*Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
# Tests hold deliberately malformed JSON as plain strings.
dotnet_diagnostic.JSON002.severity = none

# avrogen output (contracts/scripts/generate-csharp.sh): not hand-written, not analyzed.
[src/CdcPay.Contracts/Generated/**.cs]
generated_code = true

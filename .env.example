# Copy to .env and set real values. .env is git-ignored.
# SQL Server sa password: at least 8 characters with upper, lower, digit, and symbol.
MSSQL_SA_PASSWORD=change-me-Str0ng!
# PostgreSQL read model: the projector's login (owner) and the Query API's read-only login.
# Used inside connection strings, so no semicolons.
POSTGRES_PASSWORD=change-me-projector
PAYQUERY_DB_PASSWORD=change-me-query
# Grafana admin login (user admin), http://127.0.0.1:3000.
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Alertmanager configuration: alertmanager.yml (webhook sink only) or alertmanager-slack.yml
# (also Slack; put the webhook URL in monitoring/alertmanager/slack-api-url).
ALERTMANAGER_CONFIG=alertmanager.yml
